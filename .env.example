# SAP CPI tenant OData API base URL
# e.g. https://your-tenant.it-cpi017.cfapps.eu10-002.hana.ondemand.com/api/v1
MCP_CPI_BASE_URL=

# OAuth2 token endpoint
# e.g. https://your-tenant.authentication.eu10.hana.ondemand.com/oauth/token
MCP_CPI_TOKEN_URL=

# Service key client credentials
MCP_CPI_CLIENT_ID=
MCP_CPI_CLIENT_SECRET=
