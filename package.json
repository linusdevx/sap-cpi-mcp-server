{
  "name": "@linusdevx/sap-cpi-mcp",
  "version": "0.1.0",
  "description": "MCP server for SAP Cloud Platform Integration (CPI) — query packages, iFlows, message processing logs, partner directory, security material, and more via the CPI OData API.",
  "type": "module",
  "license": "MIT",
  "author": "linusdevx <sunilpharswan4198@gmail.com>",
  "homepage": "https://github.com/linusdevx/sap-cpi-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linusdevx/sap-cpi-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/linusdevx/sap-cpi-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sap",
    "cpi",
    "integration-suite",
    "claude"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "sap-cpi-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  }
}
